NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/lgionrise?schema=public

JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

REDIS_URL=redis://localhost:6379

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=20

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

CORS_ORIGIN=https://lgionrise.com

COOKIE_SECRET=change_this_to_a_random_cookie_secret
