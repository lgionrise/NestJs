generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum Language {
  ENGLISH
  HINDI
  HINGLISH
  REGIONAL
}

enum TargetExam {
  JEE_MAIN
  JEE_ADVANCED
  NEET
  BOARDS_10
  BOARDS_12
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BatchStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  ARCHIVED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id                  String        @id @default(uuid())
  username            String?       @unique
  email               String?       @unique
  phone               String?       @unique
  passwordHash        String?
  role                Role          @default(STUDENT)
  provider            AuthProvider  @default(LOCAL)
  providerId          String?

  isEmailVerified     Boolean       @default(false)
  isPhoneVerified     Boolean       @default(false)
  isActive            Boolean       @default(true)
  deletedAt           DateTime?

  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?

  twoFactorEnabled    Boolean       @default(false)
  twoFactorSecret     String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions            Session[]
  refreshTokens       RefreshToken[]
  backupCodes         TwoFactorBackupCode[]
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  createdCourses      Course[]      @relation("CourseCreatedBy")
  teachingBatches     Batch[]       @relation("BatchTeacher")

  @@index([email])
  @@index([phone])
  @@index([username])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId    String?
  userAgent   String?
  ipAddress   String?

  isRevoked   Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  replacedBy  String?

  @@index([userId])
  @@map("refresh_tokens")
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId    String
  deviceName  String?
  userAgent   String?
  ipAddress   String?
  isActive    Boolean   @default(true)

  lastActiveAt DateTime @default(now())
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model TwoFactorBackupCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model StudentProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName          String?
  photoUrl          String?
  className         String?
  targetExam        TargetExam?
  language          Language    @default(ENGLISH)
  city              String?
  state             String?
  country           String?

  dateOfBirth       DateTime?
  guardianName      String?
  guardianPhone     String?
  schoolName        String?

  onboardingStep    Int         @default(0)
  isOnboardingDone  Boolean     @default(false)

  notificationPrefs Json?
  privacySettings   Json?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@map("student_profiles")
}

model TeacherProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName          String?
  photoUrl          String?
  bio               String?
  qualifications    String?
  experienceYears   Int?
  subjects          String[]
  videoIntroUrl     String?
  youtubeUrl        String?
  linkedinUrl       String?

  approvalStatus    ApprovalStatus @default(PENDING)
  rejectionReason   String?
  approvedAt        DateTime?
  approvedByUserId  String?

  isVisible         Boolean        @default(true)

  onboardingStep    Int            @default(0)
  isOnboardingDone  Boolean        @default(false)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([approvalStatus])
  @@map("teacher_profiles")
}

model Course {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String
  targetExam      TargetExam
  className       String

  status          CourseStatus  @default(DRAFT)

  createdByUserId String
  createdBy       User          @relation("CourseCreatedBy", fields: [createdByUserId], references: [id])

  chapters        Chapter[]
  batches         Batch[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([targetExam])
  @@index([status])
  @@map("courses")
}

model Chapter {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  orderIndex  Int
  topics      String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@map("chapters")
}

model Batch {
  id                String      @id @default(uuid())
  courseId          String
  course            Course      @relation(fields: [courseId], references: [id])

  name              String
  slug              String      @unique
  description       String?

  teacherUserId     String
  teacher           User        @relation("BatchTeacher", fields: [teacherUserId], references: [id])

  language          Language    @default(ENGLISH)
  status            BatchStatus @default(DRAFT)

  priceInPaise      Int
  discountedPriceInPaise Int?
  validityDays      Int

  startDate         DateTime
  endDate           DateTime?

  maxStudents       Int?

  isFeatured        Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  schedules         BatchSchedule[]

  @@index([courseId])
  @@index([teacherUserId])
  @@index([status])
  @@map("batches")
}

model BatchSchedule {
  id        String   @id @default(uuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  dayOfWeek WeekDay
  startTime String   // "HH:mm" 24-hour format
  endTime   String   // "HH:mm" 24-hour format
  subject   String?

  createdAt DateTime @default(now())

  @@index([batchId])
  @@map("batch_schedules")
}
